{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"GeneratedExercise",
  "type":"object",
  "required":["id","templateId","sourceContentIds","skill","prompt","provenance"],
  "properties":{
    "id":{"type":"string"},"templateId":{"type":"string"},
    "sourceContentIds":{"type":"array","minItems":1,"items":{"type":"string"}},
    "skill":{"type":"string"},"level":{"enum":["A1","A2","B1","B2","C1","C2"]},
    "prompt":{"type":"string"},"options":{"type":"array","items":{"type":"string"}},
    "answer":{"type":["string","array","object","null"]},
    "explanation":{"type":["string","null"]},
    "provenance":{"type":"object"}
  }
}
